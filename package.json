{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "mini-piano",
  "title": "Mini Piano",
  "description": "A tiny piano in Raycast. Type to play notes instantly, no browser, no loading, no ads.",
  "icon": "extension-icon.png",
  "author": "nicolas-webdev",
  "categories": [
    "Media",
    "Fun"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "piano",
      "title": "Mini Piano",
      "subtitle": "Play notes",
      "description": "Type on your keyboard to play piano notes.",
      "mode": "view",
      "keywords": [
        "piano",
        "keyboard",
        "notes",
        "melody",
        "music",
        "synth"
      ]
    }
  ],
  "platforms": [
    "macOS"
  ],
  "preferences": [
    {
      "name": "tone",
      "type": "dropdown",
      "title": "Tone",
      "description": "The sound used for the notes.",
      "required": false,
      "default": "piano",
      "data": [
        {
          "title": "Electric Piano",
          "value": "piano"
        },
        {
          "title": "Pure Sine",
          "value": "sine"
        },
        {
          "title": "Organ",
          "value": "organ"
        }
      ]
    },
    {
      "name": "noteLength",
      "type": "dropdown",
      "title": "Note Length",
      "description": "How long each note rings. Short keeps fast runs clean.",
      "required": false,
      "default": "short",
      "data": [
        {
          "title": "Short",
          "value": "short"
        },
        {
          "title": "Medium",
          "value": "medium"
        },
        {
          "title": "Long",
          "value": "long"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.7.0",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist -o dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
